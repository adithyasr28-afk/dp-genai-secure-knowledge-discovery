# Copy this file to .env (which is git-ignored) and fill in your own values.
# NEVER commit a real key. A Claude Pro/Max chat subscription does NOT include
# API credits -- create an API key at https://console.anthropic.com/ .

# Required only for LIVE mode of the LLM knowledge-discovery page.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional overrides (defaults shown)
# KD_MODEL=claude-opus-5-5
# KD_EFFORT=medium
# KD_MAX_TOKENS=16000
# KD_SERVER_FALLBACK=1

# Copy this file to .env (which is git-ignored) and fill in your own values.
# NEVER commit a real key. Only LIVE mode of the LLM knowledge-discovery page
# needs a key; Demo mode works without one.

# --- Choose the LLM provider: auto | anthropic | gemini -------------------
# auto (default) = Claude if ANTHROPIC_API_KEY is set, otherwise Gemini.
# KD_PROVIDER=auto

# --- Google Gemini (google-genai SDK) ---------------------------------------
# Key from https://aistudio.google.com/ (GOOGLE_API_KEY is also accepted).
GEMINI_API_KEY=your-gemini-api-key-here
# Default is Google's current-Flash alias; the version that actually answers is
# recorded in each audit record. Pin a version for strict reproducibility:
# KD_GEMINI_MODEL=gemini-flash-latest

# --- Anthropic Claude (anthropic SDK) ---------------------------------------
# Key from https://console.anthropic.com/ (a Claude Pro/Max chat subscription
# does NOT include API credits).
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# KD_MODEL=claude-opus-5-5
# KD_EFFORT=medium
# KD_SERVER_FALLBACK=1

# --- Shared ------------------------------------------------------------------
# KD_MAX_TOKENS=16000
